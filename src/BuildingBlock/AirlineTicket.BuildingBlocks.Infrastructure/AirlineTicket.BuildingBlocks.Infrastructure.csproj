<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Localization/errors.en.json">
      <LogicalName>errors.en.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/Localization/errors.vi.json">
      <LogicalName>errors.vi.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/Localization/errors.zh.json">
      <LogicalName>errors.zh.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/Localization/errors.ja.json">
      <LogicalName>errors.ja.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/Localization/errors.ko.json">
      <LogicalName>errors.ko.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources/Localization/errors.fr.json">
      <LogicalName>errors.fr.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirlineTicket.BuildingBlocks.Application\AirlineTicket.BuildingBlocks.Application.csproj" />
  </ItemGroup>

</Project>
